{
  "hooks": {
    "agentStop": [
      {
        "bash": "discipline hook run --agent copilot --observe",
        "timeoutSec": 120,
        "type": "command"
      }
    ],
    "postToolUse": [
      {
        "bash": "discipline hook run --agent copilot --observe",
        "matcher": "create|edit|str_replace_editor|apply_patch",
        "timeoutSec": 120,
        "type": "command"
      }
    ]
  },
  "version": 1
}
